# ==============================================================================
# PHÒNG KHÁM Y HỌC CỔ TRUYỀN KOKORO — CẤU HÌNH MÔI TRƯỜNG (.env.local)
# ==============================================================================
# Cách lấy Sanity Project ID miễn phí trọn đời ($0/tháng) trong 60 giây:
#   Cách 1 (Nhanh nhất qua dòng lệnh):
#     Chạy lệnh: npx sanity@latest init --env .env.local
#     -> Đăng nhập bằng Google, tạo project mới (chọn gói Free $0/mo, dataset "production").
#
#   Cách 2 (Qua trình duyệt tại https://www.sanity.io/manage):
#     1. Tạo project miễn phí mới tại https://www.sanity.io/manage
#     2. Sao chép "Project ID" (ví dụ: a1b2c3d4) dán vào NEXT_PUBLIC_SANITY_PROJECT_ID bên dưới
#     3. Vào mục API -> CORS origins -> Thêm https://kokorowellness.vn và http://localhost:3000
#        (Tích chọn "Allow credentials" để đăng nhập trang quản trị /admin)
#
# Lưu ý: Khi chưa điền NEXT_PUBLIC_SANITY_PROJECT_ID, website vẫn hoạt động 100%
# với bộ dữ liệu chuẩn của Phòng khám Kokoro, và trang /admin sẽ hiển thị hướng dẫn cài đặt.
# ==============================================================================

# Sanity CMS Configuration ($0/month Free Forever Plan)
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"

# Canonical Site URL (used for SEO metadata, OpenGraph, sitemap.xml, and Schema.org JSON-LD)
NEXT_PUBLIC_SITE_URL="https://kokorowellness.vn"

# Optional Sanity Write Token for automated data seeding (run `npm run seed`)
# Create in Sanity Manage -> API -> Tokens -> Add API token -> Role: Editor
SANITY_API_WRITE_TOKEN=""

# Optional Webhook Secret for Instant On-Demand ISR Revalidation (/api/revalidate)
# Generate any random string (e.g. openssl rand -hex 24) and add to Sanity Webhook header
SANITY_REVALIDATE_SECRET=""
